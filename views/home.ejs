<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShorURL</title>
  </head>
  <body>
    <h1>URL shortner.</h1>
    <% if (locals.id) { %>
    <a>http://localhost:8002/<%= id %></a>
    <% } %>
    <div>
      <form method="POST" action="/url/newUser">
        <label for="">Enter your original url</label>
        <input type="text" name="url" placeholder="https://example.com" />
        <button type="submit">Generate</button>
      </form>
    </div>

    <a href="/url/viewAll">
      <button type="button">View All URLs</button>
    </a>
  </body>
</html>
