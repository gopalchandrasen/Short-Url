<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShorURL</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="home-page">
    <div class="container">
      <h1>URL Shortener</h1>
      <p class="subtitle">Make your links shorter and smarter</p>
      
      <% if (locals.id) { %>
      <div class="result-box">
        <p>Your shortened URL:</p>
        <a href="http://localhost:8002/<%= id %>" class="short-url">http://localhost:8002/<%= id %></a>
      </div>
      <% } %>
      
      <div class="form-group">
        <form method="POST" action="/url/newUser">
          <label for="url">Enter your original URL</label>
          <input type="text" name="url" id="url" placeholder="https://example.com" required />
          <button type="submit" class="btn-primary">Generate Short URL</button>
        </form>
      </div>

      <a href="/url/viewAll" class="btn-secondary">View All URLs</a>
    </div>
  </body>
</html>
