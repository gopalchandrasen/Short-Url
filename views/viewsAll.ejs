<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All URLs - ShorURL</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="viewall-page">
    <div class="container">
      <h1>All Shortened URLs</h1>
      <a href="/" class="back-link">← Back to Home</a>
      
      <% if (locals.urls && urls.length > 0) { %>
      <div class="table-wrapper">
        <table class="url-table">
          <thead>
            <tr>
              <th>S.No</th>
              <th>Short ID</th>
              <th>Original URL</th>
              <th>Clicks</th>
            </tr>
          </thead>
          <tbody>
            <% urls.forEach((url, index) => { %>
            <tr>
              <td><%= index+1 %></td>
              <td><span class="short-id"><%= url.shortId %></span></td>
              <td class="original-url" title="<%= url.redirectURL %>"><%= url.redirectURL %></td>
              <td><span class="click-count"><%= url.visitHistory.length %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty-state">
        <p>No URLs found. Start by creating your first short URL!</p>
        <a href="/" class="btn-primary">Create Short URL</a>
      </div>
      <% } %>
    </div>
  </body>
</html>
